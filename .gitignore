# Backup folder
backup

# Custom files (*sh includes sh, bash, zsh)
# Upstream ignores all of custom/ so it stays machine-local. This fork tracks it
# instead — it is where personal aliases live, and they are worth versioning.
# Anything genuinely machine-specific (or secret) goes in a *.local.zsh file,
# which stays ignored.
custom/**/*.local.*sh

# macOS
.DS_Store

# All configs
home/.config/*
home/.config/**/*
!home/.config/**/

# Exclude specific files from home/.config
!home/.config/agents/AGENTS.md
!home/.config/gh/config.yml
!home/.config/ghostty/config
!home/.config/husky/init.sh
!home/.config/yazi/yazi.toml
